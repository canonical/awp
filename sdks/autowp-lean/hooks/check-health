#!/bin/bash
# Runs as root; checks as the workshop user. The single-quoted script is
# expanded by the workshop user's login shell, not here.
# shellcheck disable=SC2016
if ! out=$(runuser -u workshop -- bash -lc '
        set -e
        lean --version
        lake --version
        rg --version | head -1
        lean-lsp-mcp --help >/dev/null
        d=$(mktemp -d); cd "$d"
        printf "theorem autowp_health (n : Nat) : n + 0 = n := rfl\n" > H.lean
        lean H.lean
        rm -rf "$d"' 2>&1); then
    workshopctl set-health error "autowp-lean: $(echo "$out" | tail -3 | tr '\n' ' ')"
    exit 0
fi
workshopctl set-health okay
