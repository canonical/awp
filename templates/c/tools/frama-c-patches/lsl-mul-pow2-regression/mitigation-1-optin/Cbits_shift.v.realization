(*  Coq realization for the opt-in CbitsShift theory.                     *)
(*                                                                        *)
(*  The single axiom `lsl_mul_pow2` in cbits_shift.mlw is IDENTICAL to    *)
(*  the one documented in ../wp-cbits-bound-lemmas/Cbits.v.realization;    *)
(*  it is realizable admit-free from the shipped Zbits theorems.  This    *)
(*  file exists so that, IF the Coq-prover path is used for a shift unit  *)
(*  (why3 realization of theory frama_c_wp.cbits_shift.CbitsShift), the    *)
(*  same one-derivation proof is on record.  For SMT (Alt-Ergo/Z3) the    *)
(*  axiom is trusted-as-stated; its soundness is by correspondence to the *)
(*  named admit-free theorem, exactly as for the global-cbits variant.    *)
(*                                                                        *)
(*  Why3 goal (theory CbitsShift):                                        *)
(*    forall (x n:Z), (0 <= n)%Z -> Cint.lsl x n = (x * (power 2 n))%Z.   *)
(*  (`lsl` here is Cbits.lsl = Cint.lsl = Zbits.lsl — the `use` chain      *)
(*   frama_c_wp.cbits.Cbits brings the identical symbol into CbitsShift.) *)
(*                                                                        *)
(*  Backing theorems (verified present, admit-free, in shipped Zbits.v):  *)
(*    Zbits.lsl_pos              : forall x n, 0<=n -> lsl x n = lsl_def x n     (:1222)  *)
(*    Zbits.lsl_arithmetic_shift : lsl_shift_def = lsl_arithmetic_def           (:918)   *)
(*        with lsl_def x n = lsl_shift_def x (Z.abs_nat n),                              *)
(*             lsl_arithmetic_def x m = x * two_power_nat m.                             *)
(*    Coq stdlib two_power_nat_correct : two_power_nat m = Zpower_nat 2 m  (ZArith/Zpower:173) *)
(*    Cint.lsl := lsl  (Cint.v:699 `exact (lsl)`) so Cint.lsl = Zbits.lsl.               *)
(*                                                                        *)
(*  Proof skeleton (same derivation as the global variant):              *)
(*    Proof. intros x n hn. rewrite Zbits.lsl_pos by exact hn. unfold Zbits.lsl_def.   *)
(*    rewrite Zbits.lsl_arithmetic_shift. unfold Zbits.lsl_arithmetic_def.             *)
(*    rewrite two_power_nat_correct, Zpower_nat_Z, Zabs2Nat.id_abs, Z.abs_eq by exact hn. *)
(*    reflexivity. Qed.                                                                *)
