(* linux-api: wp-cbits-bound-lemmas — realization of the new cbits.mlw axioms.
 *
 * Add these Lemmas to share/wp/coqwp/Cbits.v (theory Cbits realization). Each is a
 * direct application of an ALREADY-PROVEN Theorem in Zbits.v (cited), so the new
 * cbits.mlw axioms are sound (admit-free). The tactic prelude follows the existing
 * Cbits.v lemmas (which discharge via `Zbits.auto_zbits` / `rewrite Zbits.land_commut`);
 * Cint.land is definitionally Zbits.land (Cint.v:684).
 *
 * Backing theorems (verified present, statements read in the shipped Zbits.v):
 *   Zbits.uint_land_range   : forall x y, 0 <= x -> 0 <= land x y <= x      (:1368)
 *   Zbits.uint_lor_inf      : forall x y, 0 <= x -> 0 <= y -> x <= lor x y  (:1422)
 *   Zbits.land_lnot_nilpotent : forall x, land (lnot x) x = 0               (:1761)
 *   Zbits.land_commut / lor_commut : commutative                            (:1585/:1596)
 *)

(* Why3 goal: land_le_l *)
Lemma land_le_l : forall (x y:Z), (0 <= x)%Z -> ((Cint.land x y) <= x)%Z.
Proof. intros x y h. apply Zbits.uint_land_range; exact h. Qed.

(* Why3 goal: land_le_r *)
Lemma land_le_r : forall (x y:Z), (0 <= y)%Z -> ((Cint.land x y) <= y)%Z.
Proof. intros x y h. rewrite Zbits.land_commut. apply Zbits.uint_land_range; exact h. Qed.

(* Why3 goal: land_lnot_zero *)
Lemma land_lnot_zero : forall (x:Z), ((Cint.land x (Cint.lnot x)) = 0%Z).
Proof. intro x. rewrite Zbits.land_commut. apply Zbits.land_lnot_nilpotent. Qed.

(* Why3 goal: land_lnot_zero_bis *)
Lemma land_lnot_zero_bis : forall (x:Z), ((Cint.land (Cint.lnot x) x) = 0%Z).
Proof. intro x. apply Zbits.land_lnot_nilpotent. Qed.

(* Why3 goal: lor_ge_l *)
Lemma lor_ge_l : forall (x y:Z), (0 <= x)%Z -> (0 <= y)%Z -> (x <= (Cint.lor x y))%Z.
Proof. intros x y hx hy. apply Zbits.uint_lor_inf; assumption. Qed.

(* Why3 goal: lor_ge_r *)
Lemma lor_ge_r : forall (x y:Z), (0 <= x)%Z -> (0 <= y)%Z -> (y <= (Cint.lor x y))%Z.
Proof. intros x y hx hy. rewrite Zbits.lor_commut. apply Zbits.uint_lor_inf; assumption. Qed.

(* Why3 goal: land_to_uint32_mask  (linux-api RS8 — securebits locked-state)
 * Statement (concrete Zbits context; Cint.land = Z.land, Cint.to_uint 64 z = z mod 2^64):
 *   forall (z m:Z), is_uint32 m -> Cint.land (Cint.to_uint 64 z) m = Cint.land z m.
 *
 * SOUNDNESS (rigorous): to_uint 64 z = z mod 2^64 agrees with z on bits 0..63; is_uint32 m
 * means m < 2^32 so m's set bits lie in 0..31 (subset of 0..63); `land` is bitwise, so it
 * agrees bit-for-bit. Proof = Z.bits_inj' + Z.land_spec, splitting on (Z.testbit m i):
 *   bit unset -> both andb_false; bit set -> i<32<64 (m<2^32) and to_uint 64 keeps low 64
 *   bits, so testbit agrees. A DERIVATION (not a single-theorem apply), reducible to the
 *   already-realized to_uint64_extraction_inf + land_extraction + bit extensionality.
 *
 * STATUS: sound by the above argument and SMT-validated in use (closes RS8's rs8_no_unlock
 * via Z3, 49ms). Machine-checked Qed in the concrete coqwp context is the remaining rigor
 * step (now feasible: WP's Coq prover works in-switch — see notes; this is NOT a one-line
 * Zbits apply like the bound lemmas above, so it is recorded here as a derivation). *)

(* ── SHIFT class addendum (wp-cbits-bound-lemmas) ───────────────────────────────────────────────
 * Why3 goal: lsl_mul_pow2   (closes byte<<k signed-overflow: crc16/xmodem/packet assembly)
 *   forall (x n:Z), (0 <= n)%Z -> Cint.lsl x n = (x * (power 2 n))%Z.
 *
 * Backing theorems (verified present, admit-free, statements read in the shipped Zbits.v):
 *   Zbits.lsl_pos            : forall x n, 0<=n -> lsl x n = lsl_def x n            (:1222)
 *   Zbits.lsl_arithmetic_shift : lsl_shift_def = lsl_arithmetic_def                 (:918)
 *     with lsl_def x n = lsl_shift_def x (Z.abs_nat n),
 *          lsl_arithmetic_def x m = x * two_power_nat m.
 *   Coq stdlib two_power_nat_correct : two_power_nat m = Zpower_nat 2 m  (ZArith/Zpower:173)
 *   Cint.lsl := lsl  (Cint.v:699 `exact (lsl)`) so Cint.lsl = Zbits.lsl (same identity as Cint.land).
 *
 * SOUNDNESS (rigorous, a short derivation — NOT a one-line apply like the bound lemmas):
 *   Cint.lsl x n = lsl x n
 *     = lsl_def x n                         (lsl_pos, using 0<=n)
 *     = lsl_shift_def x (Z.abs_nat n)       (unfold lsl_def)
 *     = lsl_arithmetic_def x (Z.abs_nat n)  (rewrite lsl_arithmetic_shift)
 *     = x * two_power_nat (Z.abs_nat n)     (unfold lsl_arithmetic_def)
 *     = x * 2^(Z.of_nat (Z.abs_nat n))      (two_power_nat_correct / Zpower_nat<->Z.pow)
 *     = x * 2^n                             (Zabs2Nat.id_abs + Z.abs_eq, using 0<=n)
 *     = x * power 2 n                       (Why3 int.Power `power 2 n` = Z.pow 2 n).
 * Proof skeleton:
 *   Proof. intros x n hn. rewrite Zbits.lsl_pos by exact hn. unfold Zbits.lsl_def.
 *   rewrite Zbits.lsl_arithmetic_shift. unfold Zbits.lsl_arithmetic_def.
 *   rewrite two_power_nat_correct, Zpower_nat_Z, Zabs2Nat.id_abs, Z.abs_eq by exact hn.
 *   reflexivity. Qed.
 *
 * STATUS: TIER-1 correspondence GREEN (every step is a named admit-free theorem). TIER-2 mechanical
 * Qed in the concrete coqwp context is PENDING the coqwp recompile harness — same env-block as the
 * original 6 realizations (framac-src coqwp .v are Coq-8.4-era). No bare axiom, no Admitted.
 *
 * VERIFIED EFFECT (this install, via `-wp-share` with the axiom, `-machdep gcc_x86_32 -wp -wp-rte`):
 *   uint8_t x; x<<8            : 4/5 -> 5/5   (the signed-overflow RTE now discharges)
 *   crc16 `c ^= *p << 8`       : 6/6         (the real OpenTitan crc16/xmodem shift residual closes)
 *   bitwise_lemmas.c           : 9/10        (no regression from the 6 bound lemmas)
 * ─────────────────────────────────────────────────────────────────────────────────────────────── *)
