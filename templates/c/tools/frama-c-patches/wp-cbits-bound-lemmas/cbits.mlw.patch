+(** ** land/lor BOUNDS and land/lnot nilpotence (linux-api: wp-cbits-bound-lemmas patch)
+    Sound — each realized in coqwp/Cbits.v from an existing Zbits theorem:
+    land_le_l/r <- Zbits.uint_land_range ; lor_ge_l <- Zbits.uint_lor_inf ;
+    land_lnot_zero <- Zbits.land_lnot_nilpotent (+ Land commut). *)
+  axiom land_le_l: forall x y:int [land x y]. 0 <= x -> land x y <= x
+  axiom land_le_r: forall x y:int [land x y]. 0 <= y -> land x y <= y
+  axiom land_lnot_zero: forall x:int [land x (lnot x)]. (land x (lnot x)) = 0
+  axiom land_lnot_zero_bis: forall x:int [land (lnot x) x]. (land (lnot x) x) = 0
+  (* linux-api RS8 (securebits locked-state): a uint32 mask only sees bits 0..31, where
+     to_uint64 z agrees with z. Sound (uint-truncation invariance under masking); a
+     consequence of the realized to_uint64_extraction_inf + land_extraction + bit
+     extensionality. SMT-validated in use (RS8 cap_task_prctl). *)
+  axiom land_to_uint32_mask: forall z m:int [land (to_uint64 z) m].
+    is_uint32 m -> (land (to_uint64 z) m = land z m)
+
 (** ** lor identities *)
   axiom lor_idemp: forall x:int [lor x x]. (lor x x) = x
   axiom lor_idemp_bis: forall x y : int [lor x (lor x y)]. lor x (lor x y) = lor x y
@@ -55,6 +70,8 @@
   axiom lor_1bis:  forall x:int [lor x (-1)]. (lor x (-1)) = -1
