   axiom lor_0bis:  forall x:int [lor x 0]. (lor x 0) = x
+  axiom lor_ge_l: forall x y:int [lor x y]. 0 <= x -> 0 <= y -> x <= lor x y
+  axiom lor_ge_r: forall x y:int [lor x y]. 0 <= x -> 0 <= y -> y <= lor x y
 
 (** ** lxor identities *)
   axiom lxor_nilpotent: forall x:int [lxor x x]. (lxor x x) = 0
